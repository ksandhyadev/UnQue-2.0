# =========================================================
#  UnQue 2.0  –  environment variables
#  Copy to .env and fill in the values before starting.
# =========================================================

# ── Server ──────────────────────────────────────────────
PORT=5001

# ── JWT ─────────────────────────────────────────────────
# Generate with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# ── Database ─────────────────────────────────────────────
# Local MongoDB (development):
#   MONGO_URL=mongodb://127.0.0.1:27017/unque
#
# AWS DocumentDB (production):
#   MONGO_URL=mongodb://<user>:<pass>@<cluster-endpoint>:27017/unque?tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
MONGO_URL=mongodb://127.0.0.1:27017/unque

# ── DocumentDB TLS ───────────────────────────────────────
# Set DOCDB_TLS=true when connecting to AWS DocumentDB.
# DOCDB_TLS_CA_FILE is the path to the DocumentDB CA bundle.
# Download with:
#   curl -sS https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem -o global-bundle.pem
DOCDB_TLS=false
DOCDB_TLS_CA_FILE=
